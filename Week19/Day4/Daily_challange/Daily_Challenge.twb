      <aliases enabled='yes' />
      <column caption='2020 Units Sold' datatype='integer' name='[2020_units_sold]' role='measure' type='quantitative' />
      <column caption='2021 Start Stock' datatype='integer' name='[2021_start_stock]' role='measure' type='quantitative' />
      <column caption='Advertisement Costs' datatype='real' name='[Advertisement_Costs]' role='measure' type='quantitative' />
      <column caption='Direct Costs' datatype='real' name='[Calculation_1290596473450496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Raw_Material_Cost]&#13;&#10;+ [Factory_Labor_Costs]&#13;&#10;+ [Factory_Equipment_Rent_Costs]' />
      </column>
      <column caption='Invoice Year' datatype='integer' name='[Calculation_1290596474077185]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='YEAR([Invoice_Date])' />
      </column>
      <column caption='Total Orders 2021' datatype='integer' name='[Calculation_1290596474601474]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Description] :&#13;&#10;    SUM(&#13;&#10;        IF [Calculation_1290596474077185] = 2021&#13;&#10;        THEN [Quantity]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Create 2021 End Stock' datatype='integer' name='[Calculation_1290596474929155]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[2021_start_stock] - [Calculation_1290596474601474]' />
      </column>
      <column caption='Avg Inventory 2021' datatype='real' name='[Calculation_1290596475412484]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([2021_start_stock] + ([2021_start_stock] - [Calculation_1290596474601474])) &#13;&#10;* [Calculation_1290596473450496] / 2' />
      </column>
      <column caption='Total COGS 2021' datatype='real' name='[Calculation_1290596476489733]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1290596473450496] * [Calculation_1290596474601474]' />
      </column>
      <column caption='Inventory Turnover 2021' datatype='real' name='[Calculation_1290596477526022]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1290596476489733] / [Calculation_1290596475412484]' />
      </column>
      <column caption='Revenue 2021' datatype='real' name='[Calculation_1290596480278535]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_1290596474601474] * [Retail_Price]' />
      </column>
      <column caption='Revenue 2021 Percent' datatype='real' name='[Calculation_1290596481695752]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1290596480278535])&#13;&#10;/&#13;&#10;TOTAL(SUM([Calculation_1290596480278535]))&#13;&#10;* 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Cumulative Revenue Percent' datatype='real' name='[Calculation_1290596482273289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_1290596480278535]))&#13;&#10;/&#13;&#10;TOTAL(SUM([Calculation_1290596480278535]))&#13;&#10;* 100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='ABC Class' datatype='string' name='[Calculation_1290596482691082]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1290596482273289] &lt;= 80 THEN &quot;A&quot;&#13;&#10;ELSEIF [Calculation_1290596482273289] &lt;= 95 THEN &quot;B&quot;&#13;&#10;ELSE &quot;C&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Customer Country' datatype='string' name='[Customer_Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
