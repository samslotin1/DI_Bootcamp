  <worksheets>
    <worksheet name='ABC Revenue 2021'>
      <table>
        <view>
          <datasources>
            <datasource caption='Orders+ (Acropolis_Retail_data)' name='federated.1oea9l905gp9py133jjs11jhe2zj' />
          </datasources>
          <datasource-dependencies datasource='federated.1oea9l905gp9py133jjs11jhe2zj'>
            <column caption='Invoice Year' datatype='integer' name='[Calculation_1290596474077185]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='YEAR([Invoice_Date])' />
            </column>
            <column caption='Total Orders 2021' datatype='integer' name='[Calculation_1290596474601474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Description] :&#13;&#10;    SUM(&#13;&#10;        IF [Calculation_1290596474077185] = 2021&#13;&#10;        THEN [Quantity]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
            </column>
            <column caption='Revenue 2021' datatype='real' name='[Calculation_1290596480278535]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_1290596474601474] * [Retail_Price]' />
            </column>
            <column caption='Cumulative Revenue Percent' datatype='real' name='[Calculation_1290596482273289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='RUNNING_SUM(SUM([Calculation_1290596480278535]))&#13;&#10;/&#13;&#10;TOTAL(SUM([Calculation_1290596480278535]))&#13;&#10;* 100'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='ABC Class' datatype='string' name='[Calculation_1290596482691082]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_1290596482273289] &lt;= 80 THEN &quot;A&quot;&#13;&#10;ELSEIF [Calculation_1290596482273289] &lt;= 95 THEN &quot;B&quot;&#13;&#10;ELSE &quot;C&quot;&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column datatype='string' name='[Description]' role='dimension' type='nominal' />
            <column caption='Invoice Date' datatype='date' name='[Invoice_Date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Quantity]' role='measure' type='quantitative' />
            <column caption='Retail Price' datatype='real' name='[Retail_Price]' role='measure' type='quantitative' />
            <column-instance column='[Category]' derivation='None' name='[none:Category:nk]' pivot='key' type='nominal' />
            <column-instance column='[Description]' derivation='None' name='[none:Description:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1290596480278535]' derivation='Sum' name='[sum:Calculation_1290596480278535:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_1290596482691082]' derivation='User' name='[usr:Calculation_1290596482691082:nk]' pivot='key' type='nominal'>
              <table-calc ordering-type='Columns' />
              <table-calc field='[federated.1oea9l905gp9py133jjs11jhe2zj].[Calculation_1290596482273289]' ordering-type='Columns' />
