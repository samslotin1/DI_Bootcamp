import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from scipy.stats import mannwhitneyu, shapiro
from pathlib import Path
import urllib.request
import zipfile

sns.set_theme(style="whitegrid")

# Load dataset
dataset_url = "https://github.com/devtlv/Datasets-DA-Bootcamp-2-/raw/refs/heads/main/Week%208%20-%20Hackathon%20%26%20AB%20Testing/W8D3%20-%20AB%20Testing/AB_Test_Results.zip"

archive_path = Path("AB_Test_Results.zip")
data_path = Path("AB_Test_Results/AB_Test_Results/AB_Test_Results.csv")

if not data_path.exists():
    if not archive_path.exists():
        urllib.request.urlretrieve(dataset_url, archive_path)
    with zipfile.ZipFile(archive_path) as archive:
        archive.extractall("AB_Test_Results")

df = pd.read_csv(data_path)

# Quick look
display(df.head())
display(df.nunique())
display(df.describe())

# Distribution of number of A/B groups per user
group_count = df.groupby("USER_ID")["VARIANT_NAME"].nunique().value_counts()
display(group_count)

# Relative distribution
display(group_count / group_count.sum())

print(
    "Observation: Some users appear in both control and variant groups. "
    "These users should be excluded because their behavior cannot be clearly "
    "attributed to one experiment condition."
)

# Keep only users who have exactly one A/B test group
single_variant_users = df.groupby("USER_ID")["VARIANT_NAME"].nunique()
single_variant_users = single_variant_users[single_variant_users == 1].index

df = df[df["USER_ID"].isin(single_variant_users)]

# Check result
display(df.groupby("USER_ID")["VARIANT_NAME"].nunique().value_counts())

# Box plot before removing outlier
sns.boxplot(data=df, x="VARIANT_NAME", y="REVENUE")
plt.title("Revenue Distribution by Variant")
plt.show()

# Sort revenue descending to find outliers
display(df.sort_values("REVENUE", ascending=False).head(10))

# Check user 3342
display(df[df["USER_ID"] == 3342])

# Remove strong outlier
df = df[df["USER_ID"] != 3342]

# Visualize again
fig, axes = plt.subplots(2, 1, figsize=(6, 10), sharex=True)

sns.boxplot(data=df, x="VARIANT_NAME", y="REVENUE", ax=axes[0])
axes[0].set_title("All Users")

sns.boxplot(data=df[df["REVENUE"] > 0], x="VARIANT_NAME", y="REVENUE", ax=axes[1])
axes[1].set_title("Paying Users Only")

plt.tight_layout()
plt.show()

# Check users with both zero and positive revenue records
user_revenue = df.groupby("USER_ID")["REVENUE"].agg(["min", "max"])
users_with_zero_and_positive = user_revenue[
    (user_revenue["min"] == 0) & (user_revenue["max"] > 0)
]

display(users_with_zero_and_positive.head())
print("Users with both zero and positive revenue:", len(users_with_zero_and_positive))

print(
    "Yes, a user can have records with both zero and positive revenue. "
    "This suggests the records are probably visits/events, not unique users."
)

# Aggregate to one record per user
df = (
    df.groupby(["USER_ID", "VARIANT_NAME"], as_index=False)["REVENUE"]
    .sum()
)

display(df.head())

# Visualize user-level revenue distribution
fig, axes = plt.subplots(2, 1, figsize=(6, 10), sharex=True)

sns.boxplot(data=df, x="VARIANT_NAME", y="REVENUE", ax=axes[0])
axes[0].set_title("All Users After Aggregation")

sns.boxplot(data=df[df["REVENUE"] > 0], x="VARIANT_NAME", y="REVENUE", ax=axes[1])
axes[1].set_title("Paying Users After Aggregation")

plt.tight_layout()
plt.show()

# Metrics for all users
all_stat = df.groupby("VARIANT_NAME").agg({
    "USER_ID": "nunique",
    "REVENUE": ["sum", "mean", "median", "count"]
})

orders_per_user = all_stat[("REVENUE", "count")] / all_stat[("USER_ID", "nunique")]
revenue_per_user = all_stat[("REVENUE", "sum")] / all_stat[("USER_ID", "nunique")]

all_stat[("per_user", "orders")] = orders_per_user
all_stat[("per_user", "revenue")] = revenue_per_user

display(all_stat)

print(
    "The variant group has lower total revenue and lower average revenue per user "
    "than the control group."
)

# Metrics for paying users
paid_stat = df[df["REVENUE"] > 0].groupby("VARIANT_NAME").agg({
    "USER_ID": "nunique",
    "REVENUE": ["sum", "mean", "median", "count"]
})

orders_per_user = paid_stat[("REVENUE", "count")] / paid_stat[("USER_ID", "nunique")]
revenue_per_user = paid_stat[("REVENUE", "sum")] / paid_stat[("USER_ID", "nunique")]

paid_stat[("per_user", "orders")] = orders_per_user
paid_stat[("per_user", "revenue")] = revenue_per_user

display(paid_stat)

# Revenue distributions
fig, axes = plt.subplots(2, 1, figsize=(10, 8))

sns.histplot(
    data=df,
    x="REVENUE",
    hue="VARIANT_NAME",
    kde=True,
    stat="density",
    common_norm=False,
    ax=axes[0]
)
axes[0].set_title("Distribution of Revenue of All Users")

sns.histplot(
    data=df[df["REVENUE"] > 0],
    x="REVENUE",
    hue="VARIANT_NAME",
    kde=True,
    stat="density",
    common_norm=False,
    ax=axes[1]
)
axes[1].set_title("Distribution of Revenue of Paying Users")

plt.tight_layout()
plt.show()

# Shapiro-Wilk normality test
for group in ["control", "variant"]:
    result = shapiro(df.loc[df["VARIANT_NAME"] == group, "REVENUE"])
    print(f"{group}: statistic={result.statistic:.4f}, p-value={result.pvalue:.4g}")

print(
    "The p-values are far below 0.05, so we reject the null hypothesis "
    "that revenue is normally distributed."
)

# Zero revenue count
display((df["REVENUE"] == 0).value_counts())

# Mann-Whitney test for all users
mw_all = mannwhitneyu(
    df.loc[df["VARIANT_NAME"] == "variant", "REVENUE"],
    df.loc[df["VARIANT_NAME"] == "control", "REVENUE"]
)

print("Mann-Whitney test for all users:")
print(mw_all)

# Mann-Whitney test for paying users only
mw_paid = mannwhitneyu(
    df.loc[(df["VARIANT_NAME"] == "variant") & (df["REVENUE"] > 0), "REVENUE"],
    df.loc[(df["VARIANT_NAME"] == "control") & (df["REVENUE"] > 0), "REVENUE"]
)

print("Mann-Whitney test for paying users:")
print(mw_paid)

# Bootstrap functions
def get_bootstrap_samples(data, n_samples=10000):
    indices = np.random.randint(0, len(data), (n_samples, len(data)))
    return data[indices]

def stat_intervals(stat, alpha=0.05):
    return np.percentile(stat, [100 * alpha / 2, 100 * (1 - alpha / 2)])

np.random.seed(42)

# Bootstrap samples for all users
control = get_bootstrap_samples(
    df.loc[df["VARIANT_NAME"] == "control", "REVENUE"].values
)

variant = get_bootstrap_samples(
    df.loc[df["VARIANT_NAME"] == "variant", "REVENUE"].values
)

# Bootstrap samples for paying users
control_paid = get_bootstrap_samples(
    df.loc[(df["VARIANT_NAME"] == "control") & (df["REVENUE"] > 0), "REVENUE"].values
)

variant_paid = get_bootstrap_samples(
    df.loc[(df["VARIANT_NAME"] == "variant") & (df["REVENUE"] > 0), "REVENUE"].values
)

# Distribution of bootstrap means: all users
sns.kdeplot(np.mean(control, axis=1), fill=True, label="control")
sns.kdeplot(np.mean(variant, axis=1), fill=True, label="variant")
plt.title("Sample Mean Distribution for All Users")
plt.legend()
plt.show()

# Distribution of bootstrap means: paying users
sns.kdeplot(np.mean(control_paid, axis=1), fill=True, label="control")
sns.kdeplot(np.mean(variant_paid, axis=1), fill=True, label="variant")
plt.title("Sample Mean Distribution for Paying Users")
plt.legend()
plt.show()

print(
    "The bootstrap mean distributions show that control is higher than variant, "
    "but we need confidence intervals for the difference to decide statistical significance."
)

# Plot bootstrap difference and CI
def plot_distribution_and_stat_intervals(variant, control, title, alpha=0.05):
    differences = variant - control
    interval = stat_intervals(differences, alpha)

    plt.figure(figsize=(10, 5))
    sns.kdeplot(differences, fill=True)

    ymin, ymax = plt.ylim()
    plt.vlines(0, ymin, ymax, color="gray", label="0")
    plt.vlines(interval[0], ymin, ymax, color="red", linestyles="dashed", label="CI lower")
    plt.vlines(interval[1], ymin, ymax, color="red", linestyles="dashed", label="CI upper")

    plt.title(
        f"Difference Between Means: Variant - Control ({title})\n"
        f"95% CI: {interval}"
    )
    plt.legend()
    plt.show()

    return interval

# Confidence interval for all users
all_users_ci = plot_distribution_and_stat_intervals(
    np.mean(variant, axis=1),
    np.mean(control, axis=1),
    "All Users"
)

print("95% CI for difference in means, all users:", all_users_ci)

# Confidence interval for paying users
paid_users_ci = plot_distribution_and_stat_intervals(
    np.mean(variant_paid, axis=1),
    np.mean(control_paid, axis=1),
    "Paying Users"
)

print("95% CI for difference in means, paying users:", paid_users_ci)

# Final conclusion
print("""
Conclusion:

Users who appeared in both A/B groups were removed because their behavior cannot be
clearly attributed to one condition. User 3342 was also removed because it had one
extreme revenue outlier.

After cleaning, revenue was aggregated to one row per user because the user is the
experimental unit.

The variant group has lower total revenue and lower average revenue per user than
the control group. The revenue distribution is not normal, so non-parametric and
bootstrap methods were used.

The Mann-Whitney tests are not statistically significant for either all users or
paying users. The bootstrap confidence intervals for the difference in mean revenue
also include zero.

Therefore, there is no statistically significant evidence that the variant improved
revenue. Based on this data, the new version should not be launched as a
revenue-improving change without further testing.
""")
