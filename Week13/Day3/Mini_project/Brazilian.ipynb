import os
import re
import math
import sqlite3
import zipfile
from pathlib import Path

import pandas as pd
from IPython.display import display

zip_path = Path("/content/Brazilian E-Commerce Dive Deep using SQL.zip")

if not zip_path.exists():
    from google.colab import files
    uploaded = files.upload()
    zip_path = Path(next(iter(uploaded.keys())))

tables = {
    "olist_customers": "olist_customers_dataset.csv",
    "olist_sellers": "olist_sellers_dataset.csv",
    "olist_order_reviews": "olist_order_reviews_dataset.csv",
    "olist_order_items": "olist_order_items_dataset.csv",
    "olist_products_dataset": "olist_products_dataset.csv",
    "olist_geolocation": "olist_geolocation_dataset.csv",
    "product_category_name_translation": "product_category_name_translation.csv",
    "olist_orders": "olist_orders_dataset.csv",
    "olist_order_payments": "olist_order_payments_dataset.csv",
}

def find_csv_member(zip_file, csv_name):
    for member in zip_file.infolist():
        if not member.is_dir() and Path(member.filename).name == csv_name:
            return member.filename
    raise FileNotFoundError(csv_name)

engine = sqlite3.connect(":memory:")
engine.create_function("RADIANS", 1, math.radians)
engine.create_function("SIN", 1, math.sin)
engine.create_function("COS", 1, math.cos)
engine.create_function("ASIN", 1, math.asin)
engine.create_function("SQRT", 1, math.sqrt)
engine.create_function("POWER", 2, math.pow)

with zipfile.ZipFile(zip_path) as z:
    for table_name, csv_name in tables.items():
        member = find_csv_member(z, csv_name)
        with z.open(member) as f:
            df = pd.read_csv(f, encoding="utf-8-sig")
        df.to_sql(table_name, engine, if_exists="replace", index=True)
        print(table_name, df.shape)

display(pd.read_sql_query("SELECT * FROM olist_customers LIMIT 5", engine))

queries = {
    "Query 1": """
